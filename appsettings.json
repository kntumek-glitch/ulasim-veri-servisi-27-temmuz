{
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=TransportDb;Username=postgres;"
    },
    "AdminSettings": {
        "ApiKey": "test"
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    
    "GtfsImport": {
        "RetentionDays": 7,
        "KeepCompletedCount": 2
    },

    "JourneyPlan": {
        "MaxDirectTrips": 500,
        "MaxLegTrips": 500,
        "MaxCandidateStops": 15,
        "MaxTransferTrips": 150,
        "MaxTwoTransferTrips": 50,
        "MaxWaitTimeMinutes": 60,
        "MaxJourneyTimeMinutes": 240,
        "MaxWalkingMeters": 1500,
        "TransferBufferMinutes": 3,
        "MaxTransferWalkMeters": 500,
        "WalkingSpeedMetersPerSecond": 1.2,
        "MaxSearchTimeSeconds": 15
    },

    "AllowedHosts": "*",
    
    "AllowedOrigins": [
        "https://ornek.com",
        "https://app.ulasim.com",
        "https://*.vercel.app"
    ],

    "RateLimit": {
        "PermitLimit": 50,
        "WindowSeconds": 10
    },
    
    "Osrm": {
        "BaseUrl": "https://router.project-osrm.org",
        "CarBaseUrl": "https://router.project-osrm.org",
        "Profile": "foot",
        "TimeoutSeconds": 5
    },
    
    "Otp": {
        "BaseUrl": "http://localhost:8081"
    },

    "WalkingRoutingCache": {
        "TtlMinutes": 1440,
        "MaxCapacity": 10000
    }
}