{
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=TransportDb;Username=postgres;"
    },
    "AdminSettings": {
        "ApiKey": ""
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    
    "GtfsImport": {
        "RetentionDays": 7,
        "KeepCompletedCount": 2
    },

    "JourneyPlan": {
        "MaxDirectTrips": 500,
        "MaxLegTrips": 500,
        "MaxCandidateStops": 5,
        "MaxTransferTrips": 150,
        "MaxTwoTransferTrips": 50,
        "MaxWaitTimeMinutes": 60,
        "MaxJourneyTimeMinutes": 240,
        "MaxWalkingMeters": 1500,
        "TransferBufferMinutes": 3,
        "MaxTransferWalkMeters": 500,
        "WalkingSpeedMetersPerSecond": 1.2,
        "MaxSearchTimeSeconds": 15
    },

    "AllowedHosts": "*",
    
    "Osrm": {
        "BaseUrl": "http://router.project-osrm.org",
        "Profile": "foot",
        "TimeoutSeconds": 5
    },

    "WalkingRoutingCache": {
        "TtlMinutes": 1440,
        "MaxCapacity": 10000
    }
}