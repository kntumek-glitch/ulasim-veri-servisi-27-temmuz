{
  "openapi": "3.0.1",
  "info": {
    "title": "ulasım-veri-servisi",
    "description": "Transport data service API",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/import/stops": {
      "post": {
        "tags": [
          "Import"
        ],
        "summary": "ESHOT duraklarını içe aktarır",
        "description": "CSV dosyasını okuyup durakları veritabanına aktarır.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/routes/{routeNumber}/vehicles": {
      "get": {
        "tags": [
          "Routes"
        ],
        "summary": "Hattaki aktif araç konumlarını getirir",
        "description": "Belirtilen hatta çalışan aktif otobüslerin konumlarını döndürür.",
        "parameters": [
          {
            "name": "routeNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RouteVehiclesResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteVehiclesResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteVehiclesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stops": {
      "get": {
        "tags": [
          "Stops"
        ],
        "summary": "Durakları listeler",
        "description": "Sayfalama ve arama desteğiyle durak listesini döndürür.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/stops/{id}": {
      "get": {
        "tags": [
          "Stops"
        ],
        "summary": "Id'ye göre durak getirir",
        "description": "Veritabanındaki Id değerine göre durak bilgisini döndürür.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stops/by-external-id/{externalStopId}": {
      "get": {
        "tags": [
          "Stops"
        ],
        "summary": "Gerçek durak numarasına göre durak getirir",
        "description": "ESHOT durak numarasına göre durak bilgisini döndürür.",
        "parameters": [
          {
            "name": "externalStopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stops/nearby": {
      "get": {
        "tags": [
          "Stops"
        ],
        "summary": "Yakındaki durakları getirir",
        "description": "Verilen koordinata yakın durakları Haversine formülü ile hesaplar.",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "radiusMeters",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/stops/{id}/approaching-buses": {
      "get": {
        "tags": [
          "Stops"
        ],
        "summary": "Durağa yaklaşan otobüsleri getirir",
        "description": "Veritabanındaki durak Id'sine göre ESHOT API'den yaklaşan otobüsleri döndürür.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ApproachingBusResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApproachingBusResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApproachingBusResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApproachingBusItem": {
        "type": "object",
        "properties": {
          "busId": {
            "type": "string",
            "nullable": true
          },
          "routeNumber": {
            "type": "string",
            "nullable": true
          },
          "routeName": {
            "type": "string",
            "nullable": true
          },
          "remainingStopCount": {
            "type": "integer",
            "format": "int32"
          },
          "direction": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "isAccessible": {
            "type": "boolean"
          },
          "hasBicycleRack": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ApproachingBusResponse": {
        "type": "object",
        "properties": {
          "stopId": {
            "type": "integer",
            "format": "int32"
          },
          "externalStopId": {
            "type": "string",
            "nullable": true
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "fromCache": {
            "type": "boolean"
          },
          "buses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApproachingBusItem"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "RouteVehicleItem": {
        "type": "object",
        "properties": {
          "busId": {
            "type": "string",
            "nullable": true
          },
          "direction": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "RouteVehiclesResponse": {
        "type": "object",
        "properties": {
          "routeNumber": {
            "type": "string",
            "nullable": true
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "fromCache": {
            "type": "boolean"
          },
          "vehicles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteVehicleItem"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}